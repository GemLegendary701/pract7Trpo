<Window x:Class="pract7Borisov.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pract7Borisov"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Title="MainWindow" Height="600" Width="900">

    <Window.DataContext>
        <local:Filter/>
    </Window.DataContext>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,10,0,20">
            <TextBox x:Name="txCategory" Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="10,0,20,0" Padding="5" Background="White" materialDesign:HintAssist.Hint="Категория" Style="{StaticResource MaterialDesignFloatingHintTextBox}"></TextBox>
            <TextBox x:Name="txMinPrice" Text="{Binding MinPrice, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="10,0,20,0" Padding="5" Background="White" materialDesign:HintAssist.Hint="Мин цена" Style="{StaticResource MaterialDesignFloatingHintTextBox}"></TextBox>
            <Button Content="Найти" Width="120" Click="BtnSearch_Click" Style="{StaticResource MaterialDesignRaisedButton}"></Button>
            <Button Content="Сбросить" Width="120" Click="BtnReset_Click" Margin="20,0,0,0" Style="{StaticResource MaterialDesignRaisedButton}"></Button>
        </StackPanel>
        
        <Grid Grid.Row="1">
            <DataGrid x:Name="DataGridProducts"
                      ItemsSource="{Binding Products}"
                      AutoGenerateColumns="False" 
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="60"></DataGridTextColumn>
                    <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"></DataGridTextColumn>
                    <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="120"></DataGridTextColumn>
                    <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="120"></DataGridTextColumn>
                    <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="120"></DataGridTextColumn>
                    <DataGridTextColumn Header="В наличии" Binding="{Binding IsAvailable}" Width="120"></DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" Navigated="MainFrame_Navigated" />
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Создать" Click="BtnCreate_Click" Width="120" Margin="0,20,10,0" Style="{StaticResource MaterialDesignRaisedButton}"></Button>
            <Button Content="Обновить" Width="120" Click="BtnRefresh_Click" Margin="0,20,10,0" Style="{StaticResource MaterialDesignRaisedButton}"></Button>
            <Button Content="Изменить" Click="BtnEdit_Click" Width="120" Margin="0,20,10,0" Style="{StaticResource MaterialDesignRaisedButton}"></Button>
            <Button Content="Удалить" Click="BtnDelete_Click" Width="120" Margin="0,20,0,0" Style="{StaticResource MaterialDesignRaisedButton}"></Button>
        </StackPanel>

    </Grid>
</Window>