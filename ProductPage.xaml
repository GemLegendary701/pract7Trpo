<Page x:Class="pract7Borisov.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:local="clr-namespace:pract7Borisov"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="White"
      Title="Данные товара">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBox x:Name="txName" 
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,0,0,20" 
                     materialDesign:HintAssist.Hint="Название" 
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>

            <TextBox x:Name="txPrice" 
                     Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,0,0,20" 
                     materialDesign:HintAssist.Hint="Цена" 
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>

            <TextBox x:Name="txQuantity" 
                     Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,0,0,20" 
                     materialDesign:HintAssist.Hint="Количество" 
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>

            <TextBox x:Name="txCategory" 
                     Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,0,0,20" 
                     materialDesign:HintAssist.Hint="Категория" 
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>

            <CheckBox x:Name="cbIsAvailable" 
                      IsChecked="{Binding IsAvailable}" 
                      Content="В наличии" 
                      Margin="0,0,0,20" 
                      Style="{StaticResource MaterialDesignCheckBox}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" 
                    Style="{StaticResource MaterialDesignRaisedButton}" 
                    Margin="0,0,10,0" 
                    Width="120" 
                    Click="BtnSave_Click"/>

            <Button Content="Отмена" 
                    Style="{StaticResource MaterialDesignFlatButton}" 
                    Width="120" 
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Page>